# 复制本文件为 keystore.properties（同目录）并填入真实值；
# keystore.properties 已被 .gitignore 忽略，绝不入库。
# 也可以不使用此文件，改为设置同名环境变量（CI 走的正是环境变量方式）。
#
# keystore 生成示例（PKCS12）：
#   keytool -genkeypair -v -keystore my-release.keystore -alias my-alias \
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
#
# 务必备份 keystore 与密码：丢失后将无法为已安装用户发布更新。

KEYSTORE_FILE=D:/path/to/your-release.keystore
KEYSTORE_PASSWORD=your-store-password
KEY_ALIAS=your-key-alias
KEY_PASSWORD=your-key-password
